<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMaui.Views.AlunoPView"
              xmlns:vm="clr-namespace:AppMaui.ViewsModels"
             x:DataType="vm:AlunoPViewModel"
             xmlns:model="clr-namespace:AppMaui.Core.Models"
             xmlns:views="clr-namespace:AppMaui.Views"
             xmlns:dto="clr-namespace:AppMaui.Core.DTOs"
             >
    <Grid>
        <Grid.RowDefinitions >
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
                  
        </Grid.ColumnDefinitions>
    
    <Border x:Name="brdLista"                 
     Stroke="{StaticResource palhaMedio}" 
     Margin="15"
     VerticalOptions="Fill" 
     Style="{StaticResource sBrdPrincipal}">
        <Grid>
            <Grid.RowDefinitions >
                <RowDefinition Height="{OnIdiom Phone=0.13*, Tablet=1.1*, Desktop=0.1*}"/>
                    <RowDefinition Height="{OnIdiom Phone=0.07*, Tablet=1.1*, Desktop=0.1*}"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{OnIdiom Phone= 2*, Tablet= 1.5*, Desktop= 0.3*}"/>
                    <ColumnDefinition Width="{OnIdiom Phone= 0.8*, Tablet= 1.5*, Desktop= 0.2*}"/>
                    <ColumnDefinition Width="{OnIdiom Phone= 0.8*, Tablet= 1.5*, Desktop= 0.3*}"/>
                    <ColumnDefinition Width="{OnIdiom Phone= 0.8*, Tablet= 1.5*, Desktop= 0.3*}"/>
                    <ColumnDefinition Width="{OnIdiom Phone= 0.8*, Tablet= 1.5*, Desktop= 0.2*}"/>
                    <ColumnDefinition Width="{OnIdiom Phone= 0.8*, Tablet= 1.5*, Desktop= 0.3*}"/>                   
                </Grid.ColumnDefinitions>

            <!--Cabeçalho lista-->
            <Rectangle x:Name="rtgLista" 
                Grid.ColumnSpan="6"
                Fill="{StaticResource marromClaro}" 
                Stroke="{StaticResource marromClaro}"
                />
            <Image x:Name="imgLtAlunos" 
            TranslationX="10" 
            HorizontalOptions="Start"
            Source="alunos.webp" 
            Style="{StaticResource sImgCabecalho}"
            />
         
            <Label x:Name="lbAlunosTituloSombra4" 
                   Grid.ColumnSpan="6"
                   VerticalOptions="Center"
             TranslationX="-20"
             HorizontalOptions="Center"    
            FontSize="20"
            Text="ALUNOS" 
            Style="{StaticResource sLbSombra4}"  
            />
            <Label x:Name="lbAlunosTitulo" 
                   Grid.ColumnSpan="6"
                   VerticalOptions="Center"
             TranslationX="-20"
            FontSize="20"
            Text="ALUNOS" 
            HorizontalOptions="Center"
            Style="{StaticResource sLbTitulo}"   
            />

                <Label 
                       Grid.Row="1"
         Grid.Column="1"
         Margin="0,5"
         Text="NickName" 
         FontAttributes="Bold"    
         FontSize="{OnIdiom Phone=12, Desktop=15}"   
                    TranslationX="{OnIdiom Phone=-25, Desktop=0}"
         VerticalOptions="Center"
         HorizontalOptions="Center"
         TextColor="{StaticResource marromEscuro}"/>
                <Label 
                       Grid.Row="1"
         Grid.Column="2"
         Margin="0,5"
         Text="Nome" 
         FontAttributes="Bold"    
         FontSize="{OnIdiom Phone=12, Desktop=15}"   
                     TranslationX="{OnIdiom Phone=-20, Desktop=0}"
         VerticalOptions="Center"
         HorizontalOptions="Center"
         TextColor="{StaticResource marromEscuro}"/>
                <Label 
                       Grid.Row="1"
         Grid.Column="3"
         Margin="0,5"
         Text="Cód de Acesso" 
         FontAttributes="Bold"    
         FontSize="{OnIdiom Phone=12, Desktop=15}"   
             TranslationX="{OnIdiom Phone=-15, Desktop=0}"                                   
         VerticalOptions="Center"
         HorizontalOptions="Center"
         TextColor="{StaticResource marromEscuro}"/>
                <Label 
                       Grid.Row="1"
         Grid.Column="4"
         Margin="0,5"
         Text="Livro Atual" 
         FontAttributes="Bold"    
         FontSize="{OnIdiom Phone=12, Desktop=15}"   
             TranslationX="{OnIdiom Phone=-5, Desktop=0}"                                   
         VerticalOptions="Center"
         HorizontalOptions="Center"
         TextColor="{StaticResource marromEscuro}"/>
                <Label 
                       Grid.Row="1"
         Grid.Column="5"
         Margin="0,5"
         Text="Total de leituras" 
         FontAttributes="Bold"    
          FontSize="{OnIdiom Phone=12, Desktop=15}"   
             TranslationX="{OnIdiom Phone=-5, Desktop=0}"                                  
         VerticalOptions="Center"
         HorizontalOptions="Center"
         TextColor="{StaticResource marromEscuro}"/>

        <!--Seletor de turma-->
               
                <Border Margin="10,1"    
                        TranslationY="0"
                         Grid.Column="5"    
                         HeightRequest="{OnIdiom Phone=35, Desktop=35}"
                         HorizontalOptions="End"
                        VerticalOptions="End"
                         Style="{StaticResource sBrdEntry}">
                    <Picker ItemsSource="{Binding Turmas}" 
                            SelectedItem="{Binding TurmaSelecionada}"
                            ItemDisplayBinding="{Binding Nome}"
                            TextColor="{StaticResource marromMedio}"
                           FontSize="{OnIdiom Phone=10, Desktop=12}"  
                          WidthRequest="100"
                           />
                </Border>
                <Label Grid.Column="4" 
                       Grid.ColumnSpan="2"
        VerticalOptions="Start"                       
        TextColor="{StaticResource begeMedio}" 
        FontAttributes="Bold" 
        Text="TURMA:"/>
                <Label Grid.Row="2"                       
                       Margin="10"
                       FontSize="{OnIdiom Phone=12}"
                       TextColor="{StaticResource palhaEscuro}" 
                       Text="{Binding Mensagem}"/>
                <!--lista-->             
                   
                <CollectionView ItemsSource="{Binding Alunos}"
                                Grid.Row="2" Grid.ColumnSpan="6">
                    <CollectionView.ItemTemplate> 
                        <DataTemplate x:DataType="dto:AlunoPDTO">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{OnIdiom Phone=1*, Desktop= 0.6*}"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.GestureRecognizers>
         <TapGestureRecognizer
             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlunoPViewModel}}, Path=AlterarCadastroCommand}"
             CommandParameter="{Binding}"/>                                        
     </Grid.GestureRecognizers>
                               <Border 
              BackgroundColor="{StaticResource azulClaro}"
              Margin="0"                        
              HorizontalOptions="Fill"
              TranslationY="{OnIdiom Phone=0, Desktop=10}"
              TranslationX="{OnIdiom Phone=15, Desktop=20}"
              VerticalOptions="Start"
              Style="{StaticResource sBrdAzul}">                                    
                                    <Label     
                                        Text="{Binding Patente}" 
                                        HorizontalOptions="Center"
                                        FontSize="10"
                                        TextColor="{StaticResource begeClaro}"/>
                                </Border>
                                <Label x:Name="lbNick"                                        
 Grid.Column="1"
 Margin="5"
 Text="{Binding Nickname}" 
 FontAttributes="Bold"    
 FontSize="{OnIdiom Phone=12, Desktop=15}"   
TranslationX="{OnIdiom Phone=20, Desktop=0}"
 VerticalOptions="Center"
 HorizontalOptions="Center"
 TextColor="{StaticResource marromEscuro}"/>


                                <Label x:Name="lbAluno"                                          
         Grid.Column="2"
         Margin="0,5"                                        
         Text="{Binding Nome}" 
         FontAttributes="Bold"                      
         FontSize="{OnIdiom Phone=10, Desktop=15}" 
         TranslationX="{OnIdiom Phone=25, Desktop=0}"
         VerticalOptions="Center"
         HorizontalOptions="Start"
         TextColor="{StaticResource marromEscuro}"
         />
                                <Label x:Name="lbCodigo"                                          
         Grid.Column="3"
         Margin="0,5"                                        
         Text="{Binding CodigoAcesso}" 
         FontAttributes="Bold"                      
          FontSize="{OnIdiom Phone=10, Desktop=15}" 
        TranslationX="{OnIdiom Phone= 10, Desktop=0}"
         VerticalOptions="Center"
         HorizontalOptions="Center"
         TextColor="{StaticResource marromEscuro}"
         />
                                <Image x:Name="imgLivro"                                       
         Grid.Column="4"
         Source="{Binding CapaLivroAtual}"
         VerticalOptions="Center"
                TranslationX="{OnIdiom Phone= 5, Desktop=0}"
                HorizontalOptions="Center"
                HeightRequest="30"
         Margin="{OnIdiom Phone=5, Desktop=20}"
         />
                                <Label x:Name="lbQtdLivros"                                       
         Grid.Column="5"
         Text="{Binding QuantidadeLivrosLidos}"
         FontAttributes="Bold"   
          FontSize="{OnIdiom Phone=12, Desktop=15}"   
         TranslationX="{OnIdiom Phone=-5, Desktop=0}"
         VerticalOptions="Center"   
                HorizontalOptions="Center"
         TextColor="{StaticResource marromEscuro}"
         />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
    </Border>
        <!--botão de cadastrar aluno-->
        <Button x:Name="BtnAddAluno" 
HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,15,5,0"
                FontSize="{OnIdiom Phone=15, Desktop=25}"
                TranslationY="{OnIdiom Phone=-10, Desktop=5}"
Text="+"
Style="{StaticResource sBtn}"
BackgroundColor="{StaticResource verdeMedio}"     
                Command="{Binding AbrirCadastroCommand}"

/>
        <!--abre a tela de cadastro e alterar senha (overlay) e Primeiro Acesso-->
        <ContentView            
 x:Name="cvCadastro" 
 Grid.ColumnSpan="2"
 IsVisible="{Binding MostrarCadastro}"
             InputTransparent="False">
            <views:CadastroAView
      BindingContext="{Binding CadastroAVM}"/>
         
        </ContentView>
        
    </Grid>
</ContentView>