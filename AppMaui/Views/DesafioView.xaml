<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMaui.Views.DesafioView"
             xmlns:vm="clr-namespace:AppMaui.ViewsModels"
             x:DataType="vm:DesafioViewModel"
             xmlns:DTO="clr-namespace:AppMaui.Core.DTOs"
             xmlns:model="clr-namespace:AppMaui.Core.Models"
             xmlns:views="clr-namespace:AppMaui.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{OnIdiom Phone=0.4*, Desktop=0.2*}"/>
            <RowDefinition Height="{OnIdiom Phone=0.6*, Desktop=1*}"/>           
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Identificação do livro-->
        <Border 
           Stroke="{StaticResource verdeMedio}" 
           Margin="15,5"                  
           Grid.ColumnSpan="{OnIdiom Phone=2, Desktop=1}"
           VerticalOptions="Fill"
           Style="{StaticResource sBrdPrincipal}">
            <Grid>
                <Rectangle   
                    Fill="{StaticResource verdeEscuro}" 
                    Stroke="{StaticResource verdeEscuro}"   
                    />

                <Image 
                  Margin="15,5" 
                  HorizontalOptions="Start"
                  Source="{Binding Capa}"
                  Style="{StaticResource sImgCabecalho}"
                  />
                <Label 
                  VerticalOptions="Center" 
                  FontSize="{OnIdiom Phone=16, Desktop=20}"
                  HorizontalOptions="Start"  
                  TranslationX="{OnIdiom Phone= 59,Desktop=69}"                         
                  Text="{Binding Titulo}" 
                  Style="{StaticResource sLbSombra1}"   
                  />
                <Label 
                  VerticalOptions="Center" 
                  HorizontalOptions="Start" 
                  TranslationX="{OnIdiom Phone= 59,Desktop=69}"                   
                  FontSize="{OnIdiom Phone=16, Desktop=20}"
                  Text="{Binding Titulo}" 
                  Style="{StaticResource sLbSombra2}"     
                  />
                <Label
                  Text="{Binding Titulo}" 
                  HorizontalOptions="Start" 
                  TranslationX="{OnIdiom Phone= 61,Desktop=71}"                   
                  Style="{StaticResource sLbSombra3}"  
                  VerticalOptions="Center" 
                  FontSize="{OnIdiom Phone=16, Desktop=20}"
                  />
                <Label
                  Grid.ColumnSpan="2"
                  VerticalOptions="Center" 
                  FontSize="{OnIdiom Phone=16, Desktop=20}"
                  HorizontalOptions="Start" 
                  TranslationX="{OnIdiom Phone= 61,Desktop=71}"                    
                  Text="{Binding Titulo}"                        
                  Style="{StaticResource sLbSombra4}"  
                  />
                <Label
                    VerticalOptions="Center"   
                  FontSize="{OnIdiom Phone=16, Desktop=20}"
                  HorizontalOptions="Start" 
                  TranslationX="{OnIdiom Phone= 60,Desktop=70}"                    
                  Text="{Binding Titulo}" 
                  Style="{StaticResource sLbTitulo}"   
                  />
            </Grid>
        </Border>

        <!--palavra secreta-->
        <Border 
            Stroke="{StaticResource verdeMedio}"        
            Grid.Column="1"                      
            Margin="15,5"                                            
            VerticalOptions="Fill" 
            Style="{StaticResource sBrdPrincipal}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{OnIdiom Phone=0.5*, Desktop=0.7*}"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>                    
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Rectangle 
                    Fill="{StaticResource verdeEscuro}" 
                    Stroke="{StaticResource verdeEscuro}"
                    />
                <Label     
                  TranslationX="10"
                  VerticalOptions="Fill"
                  FontSize="{OnIdiom Phone=15, Desktop=16}"
                  HorizontalOptions="{OnIdiom Phone=Start, Desktop=Start}"
                  Text="PALAVRA SECRETA:"
                  Style="{StaticResource sLbSombra1}"   
                  />
                <Label
                  VerticalOptions="Center"
                  TranslationX="10"
                  HorizontalOptions="{OnIdiom Phone=Start, Desktop=Start}"
                  FontSize="{OnIdiom Phone=15, Desktop=16}"
                  Text="PALAVRA SECRETA:"
                  Style="{StaticResource sLbSombra2}"     
                  />
                <Label
                  TranslationX="10"
                  Text="PALAVRA SECRETA:"
                  HorizontalOptions="{OnIdiom Phone=Start, Desktop=Start}"
                  Style="{StaticResource sLbSombra3}"  
                  VerticalOptions="Center"
                  FontSize="{OnIdiom Phone=15, Desktop=16}"
                  />
                <Label 
                  TranslationX="10"
                  VerticalOptions="Center"
                  FontSize="{OnIdiom Phone=15, Desktop=16}"
                  HorizontalOptions="{OnIdiom Phone=Start, Desktop=Start}"
                  Text="PALAVRA SECRETA:"
                  Style="{StaticResource sLbSombra4}"  
                  />
                <Label 
                  TranslationX="10"
                  VerticalOptions="Center"
                  FontSize="{OnIdiom Phone=15, Desktop=16}"
                  HorizontalOptions="{OnIdiom Phone=Start, Desktop=Start}"
                  Text="PALAVRA SECRETA:"
                  Style="{StaticResource sLbTitulo}"   
                  />    
                <!--entradas da palavras secreta-->
                <HorizontalStackLayout
    Grid.Row="1"
    Spacing="2"
    Margin="5,0"
                    
    BindableLayout.ItemsSource="{Binding PalavraSecretaLetras}">

                    <BindableLayout.ItemTemplate>

                        <DataTemplate x:DataType="DTO:LetraDTO">

                            <Grid>

                                <Border
                    Stroke="{StaticResource marromClaro}"
                    Style="{StaticResource sBrdEntry}"
                    Margin="2"
                                   Padding="0"
                               TranslationY="-1"    
                    WidthRequest="35"
                    HeightRequest="30">

                                    <Border.Triggers>

                                        <DataTrigger
                            TargetType="Border"
                            Binding="{Binding Correta}"
                            Value="True">

                                            <Setter Property="Stroke"
                                    Value="Green"/>

                                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource verdeSuave}"/>

                                        </DataTrigger>

                                    </Border.Triggers>

                                    <Entry
                        Text="{Binding LetraDigitada}"
                                        
                                        TranslationX="-8"
                                        TranslationY="-7"
                        TextTransform="Uppercase"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource marromEscuro}"
                        FontSize="18"
                                        />

                                </Border>

                            </Grid>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </Grid>
        </Border>
        <CollectionView Grid.Row="1"                         
                        ItemsSource="{Binding DesafiosDTOEsquerda}"
                         Margin="15,5"   >
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="DTO:DesafiosDTO">
                    <!--lista de desafio-->
                    <Border x:Name="brdDesafio"  
           Stroke="{StaticResource azulClaro}"            
                HeightRequest="75"                       
           Style="{StaticResource sBrdPrincipal}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{OnIdiom Phone=0.5*, Desktop=0.5*}"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Rectangle 
                      Grid.ColumnSpan="20"
                      Fill="{StaticResource azulMedio}" 
                      Stroke="{StaticResource azulMedio}"
                      />
                            <Label 
                  Grid.ColumnSpan="20"
                  TranslationY="-2"
                  FontSize="{OnIdiom Phone=15, Desktop=15}"
                       TranslationX="15"
                  HorizontalOptions="{OnIdiom Phone=Start, Desktop=Start}"
                  Text="{Binding Pergunta}"
                  Style="{StaticResource sLbTitulo}"   
                  />
                            <HorizontalStackLayout
    Grid.Row="1"
    Spacing="2"
    BindableLayout.ItemsSource="{Binding Letras}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="DTO:LetraDTO">

                                        <Grid>

                                            <Border
                    Stroke="{StaticResource marromClaro}"
                    Style="{StaticResource sBrdEntry}"
                    Margin="2"
                                                TranslationY="0"
                                               
                    WidthRequest="35"
                    HeightRequest="35">
                                                <Border.Triggers>
                                                   

                                                    <DataTrigger
TargetType="Border"
Binding="{Binding Destacada}"
Value="True">

                                                        <Setter
    Property="BackgroundColor"
    Value="{StaticResource begeClaro}"/>
                                                        <Setter Property="StrokeThickness" Value="3"/>

                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
              Binding="{Binding Correta}"
              Value="True">
                                                        <Setter Property="Stroke" Value="Green"/>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource verdeSuave}"/>
                                                    </DataTrigger>

                                                </Border.Triggers>
                                                <Entry
                       
                        TextTransform="Uppercase"
                                                    Text="{Binding LetraDigitada}"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource marromEscuro}"
                        FontSize="18"/>

                                            </Border>

                                            <Label
                        FontFamily="FontAwesome"
Text="{Binding LetraCriptograma}"
     TextColor="{StaticResource marromMedio}"
VerticalOptions="Start"
Margin="2"
TranslationY="5"
TranslationX="5"
/>

                                        </Grid>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView Grid.Row="1" 
                        Grid.Column="1"
                        ItemsSource="{Binding DesafiosDTODireita}"
                         Margin="15,5"   >
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="DTO:DesafiosDTO">
                    <!--lista de desafio-->
                    <Border x:Name="brdDesafio"  
           Stroke="{StaticResource azulClaro}"            
                HeightRequest="75"                       
           Style="{StaticResource sBrdPrincipal}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{OnIdiom Phone=0.5*, Desktop=0.5*}"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>                                
                            </Grid.ColumnDefinitions>
                            <Rectangle 
                      Grid.ColumnSpan="20"
                      Fill="{StaticResource azulMedio}" 
                      Stroke="{StaticResource azulMedio}"
                      />
                            <Label 
                  Grid.ColumnSpan="20"
                  TranslationY="-2"
                  FontSize="{OnIdiom Phone=15, Desktop=15}"
                       TranslationX="15"
                  HorizontalOptions="{OnIdiom Phone=Start, Desktop=Start}"
                  Text="{Binding Pergunta}"
                  Style="{StaticResource sLbTitulo}"   
                  />
                            <HorizontalStackLayout
    Grid.Row="1"
    Spacing="2"
    BindableLayout.ItemsSource="{Binding Letras}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="DTO:LetraDTO">

                                        <Grid>

                                            <Border
                    Stroke="{StaticResource marromClaro}"
                    Style="{StaticResource sBrdEntry}"
                    Margin="2"
                                                TranslationY="0"
                                               
                    WidthRequest="35"
                    HeightRequest="35">
                                                <Border.Triggers>

                                                    <DataTrigger
                                                        TargetType="Border"
                                                        Binding="{Binding Destacada}"
                                                        Value="True">     
                                                        <Setter
                                                            Property="BackgroundColor"
                                                            Value="{StaticResource begeClaro}"/>
                                                        <Setter Property="StrokeThickness"
                                                                Value="3"/>

                                                    </DataTrigger>
                                                    
                                                    <DataTrigger TargetType="Border"
              Binding="{Binding Correta}"
              Value="True">
                                                        <Setter Property="Stroke" Value="Green"/>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource verdeSuave}"/>
                                                    </DataTrigger>

                                                </Border.Triggers>

                                                <Entry                        
                        TextTransform="Uppercase"
                        HorizontalTextAlignment="Center"
                                                    Text="{Binding LetraDigitada}"
                        TextColor="{StaticResource marromMedio}"
                        FontSize="18"/>

                                            </Border>

                                            <Label
                        FontFamily="FontAwesome"
Text="{Binding LetraCriptograma}"
     TextColor="{StaticResource marromMedio}"
VerticalOptions="Start"
Margin="2"
TranslationY="5"
TranslationX="5"/>

                                        </Grid>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>                           
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
       
        <!--botões-->
        <!--botão de SALVAR-->
        <Button 
           Grid.Row="1"    
                Grid.Column="1"
                VerticalOptions="End"
           HorizontalOptions="End" 
           Text="SALVAR"
           Style="{StaticResource sBtn}"
           BackgroundColor="{StaticResource verdeMedio}" 
            Command="{Binding ValidarRespostasCommand}"
           />   
    </Grid>
</ContentView>
