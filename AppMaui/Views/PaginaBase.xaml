<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMaui.Views.PaginaBase"
             xmlns:views="clr-namespace:AppMaui.Views"   
             xmlns:vm="clr-namespace:AppMaui.ViewsModels"
             x:DataType="vm:PaginaBaseViewModel"             
             BackgroundColor="{StaticResource begeClaro}"
              Shell.NavBarIsVisible="False"
             Title="PaginaBase">

    <Grid>
    <Grid.RowDefinitions >
        <!--linha do cabeçaho principal-->
        <RowDefinition Height="{OnIdiom Phone=0.15*, Desktop=0.3*}"/>
        <!--linha de conteudo-->
        <RowDefinition Height="{OnIdiom Phone=1*, Desktop=2.1*}"/>
        <!--linha de navegação-->
        <RowDefinition Height="{OnIdiom Phone=0.1*, Desktop=0.3*}"/>
        <!--linha de rodapé-->
        <RowDefinition Height="{OnIdiom Phone=0.03*, Desktop=0.05*}"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <!--cabeçalho principal-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0.3*, Desktop=0.1*}"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- cabeçalho-->
        <!-- backgrounds do cabeçalho-->
        <Rectangle x:Name="rtgSuperior" 
                  Grid.ColumnSpan="2"   
                  Fill="{StaticResource palhaEscuro}" 
                  Stroke="{StaticResource palhaEscuro}"
                  />
        <Rectangle x:Name="rtgInferior"  
                  Grid.Row="1" 
                  Grid.ColumnSpan="2"  
                  Fill="{StaticResource azulMedio}" 
                  Stroke="{StaticResource azulMedio}"
                  />

        <!-- Logo-->
        <Image x:Name="imgCabecalho" 
              Grid.RowSpan="2"    
              Source="professor.webp" 
               WidthRequest="{OnIdiom Phone=60, Desktop=60}"
              Style="{StaticResource sImgCabecalho}"
          />       
        <Label x:Name="lbTitulo1Sombra4" 
              Grid.Column="1"     
                TranslationX="{OnIdiom Phone= 124, Desktop=149}"
                TranslationY="{OnIdiom Phone= 1, Desktop=-4}"
              Text="AGÊNCIA DOS JOVENS" 
              Style="{StaticResource sLbSombra4}"             
              />
        <Label x:Name="lbTitulo1" 
              Grid.Column="1"        
              Text="AGÊNCIA DOS JOVENS" 
               TranslationX="{OnIdiom Phone=125, Desktop=150}"
               TranslationY="{OnIdiom Phone= 2, Desktop=-5}"
              Style="{StaticResource sLbTitulo}"           
              />      
        <Label x:Name="lbTitulo2Sombra4" 
              Grid.Column="1"
               TranslationX="{OnIdiom Phone= 134, Desktop= -149}"
               TranslationY="{OnIdiom Phone= -1, Desktop= -5}"
              Text="LEITORES DETETIVES" 
              Style="{StaticResource sLbSombra8}"
              VerticalOptions="End"
              />
        <Label x:Name="lbTitulo2" 
              Grid.Column="1"
               TranslationX="{OnIdiom Phone= 135, Desktop= -150}"
               TranslationY="{OnIdiom Phone= -2, Desktop= -5}"
              Text="LEITORES DETETIVES" 
              Style="{StaticResource sLbTitulo1}"
              VerticalOptions="End"
              />      
            <!-- botão sair-->
            <Button Grid.Row="1" 
                    Grid.Column="1"
                    HorizontalOptions="End"
                    TranslationX="{OnIdiom Phone= -2}"
                    TranslationY="{OnIdiom Phone=-2, Desktop=-4}"
                    HeightRequest="{OnIdiom Phone= 40}"
                    Text="&#xf08b;"
                    FontFamily="FontAwesome"
                    BackgroundColor="Transparent"
                    FontSize="{OnIdiom Phone= 22, Desktop=25}"
                    TextColor="{StaticResource begeClaro}"
                    Command="{Binding SairCommand}"/>            

            <!-- Sino Notificação-->
        <Button
              Grid.Column="1"  
              FontSize="23"
              HorizontalOptions="Start"
            TranslationY="{OnIdiom Phone= -4, Desktop=-3}"
            TranslationX="-1"
            FontFamily="FontAwesomeR"
              Text="&#xf0f3;"
            TextColor="{StaticResource begeClaro}"
              BackgroundColor="Transparent"
            />
            <Button
              Grid.Column="1"  
              FontSize="15"
              HorizontalOptions="Start"
            TranslationY="-3"
            TranslationX="1"
            FontFamily="FontAwesomeR"
              Text="&#xf0f3;"
            TextColor="{StaticResource begeClaro}"
              BackgroundColor="Transparent"
            />
            <Button
              Grid.Column="1"  
              FontSize="20"
              HorizontalOptions="Start"
            TranslationY="-3"
            FontFamily="FontAwesomeR"
              Text="&#xf0f3;"
            TextColor="{StaticResource verdeEscuro}"
              BackgroundColor="Transparent"
            />
        
        <!--Botão sincronia-->
            <Button
              Grid.Column="1"  
              FontSize="20"
              HorizontalOptions="Start"
            TranslationY="-2"
                TranslationX="35"
            FontFamily="FontAwesome"
              Text="&#xf2f1;"
            TextColor="{StaticResource begeClaro}"
              BackgroundColor="Transparent"
            />     
        
        <!--usuario e edição-->
        <Label x:Name="lbUsuario" 
               Text="{Binding User}"
              Grid.Row="1" 
              Grid.Column="1"              
              Style="{StaticResource sLbUsuario}"/>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    HorizontalOptions="Start"
                    IsVisible="{Binding BotaoEdicao}"
                    TranslationY="-3"  
                    FontFamily="FontAwesomeR"
                    TextColor="{StaticResource begeClaro}"
                    FontSize="20"          
                    Text="&#xf044;"
                    BackgroundColor="Transparent"
                    Command="{Binding AbrirEdicaoUserCommand}"/>

        </Grid>    

    <!--View corpo-->
    <ContentView x:Name="Corpo" 
                 Grid.Row="1"
                 Content="{Binding ViewAtiva}"
                 />
        <!--abre a tela de cadastro e alterar senha (overlay) e Primeiro Acesso-->
        <ContentView            
x:Name="cvCadastro"
Grid.Row="1" 
Grid.ColumnSpan="2"
IsVisible="{Binding MostrarCadastro}"
InputTransparent="False">
            <views:CadastroPView 
    BindingContext="{Binding CadastroPVM}"/>
        </ContentView>

        <!--view navegação-->
    <!-- rodapé-->
    <Grid Grid.Row="2">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition />
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- BOTÃO HOME-->
        <Rectangle  x:Name="retRoda"  
                  Grid.Row="2"     
                  Grid.ColumnSpan="4"
                  Fill="{StaticResource azulMedio}"
                  Stroke="{StaticResource azulMedio}"
                  />
        <ImageButton x:Name="BtnHome" 
                   Grid.RowSpan="2"
                   BackgroundColor="Transparent"
                   Source="home.webp" 
                   Margin="10"
                     Command="{Binding AbrirHomeCommand}"
                   />
        <!-- BOTÃO PRIMEIRA VIEW-->
        <Border x:Name="brdBtFundo1" 
              Grid.RowSpan="2"
              Grid.Column="1"
              TranslationY="6"
              Margin="5"
              Style="{StaticResource sBrdPrincipalSS}"
              Stroke="{StaticResource palhaMedio}">
            <Label Padding="5"/>
        </Border>
        <ImageButton x:Name="BtnAlunos" 
                   Grid.RowSpan="2"  
                   Grid.Column="1" 
                   Margin="5"
                   Source="{Binding ImgBotao1}"
                   TranslationY="-15"      
                     Command="{Binding AbrirPrimViewCommand}"
                   />
        <Border x:Name="brdBtPriView" 
              Grid.RowSpan="2"  
              Grid.Column="1" 
              Margin="5"
              TranslationY="6" 
              VerticalOptions="Center"
              Padding="0"
              Style="{StaticResource sBrdAzulSS}"
              Stroke="{StaticResource palhaMedio}">
                <Label Text="{Binding LbBotao1}" 
                   FontAttributes="Bold"
                 TextColor="{StaticResource begeClaro}"
                 HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirPrimViewCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
        </Border>

        <!-- BOTÃO SEGUNDA VIEW-->
        <Border x:Name="brdBtFundo2" 
              Grid.RowSpan="2"
              Grid.Column="2"
              TranslationY="5" 
              Margin="5"
              Style="{StaticResource sBrdPrincipalSS}"
              Stroke="{StaticResource palhaMedio}">
            <Label Padding="5"/>
        </Border>
        <ImageButton x:Name="BtnSegView" 
                   Grid.Column="2" 
                   Grid.RowSpan="2" 
                   Margin="5"
                   Source="{Binding ImgBotao2}"
                   TranslationY="-10"
                     Command="{Binding AbrirSegViewCommand}"
                  />
        <Border x:Name="brdBtTurmas" 
              Grid.Column="2" 
              Grid.RowSpan="2"
              Margin="5"
              TranslationY="6" 
              VerticalOptions="Center"
              Padding="0"
              Style="{StaticResource sBrdAzulSS}"
              Stroke="{StaticResource palhaMedio}">
                <Label Text="{Binding LbBotao2}" 
                   FontAttributes="Bold"
                 TextColor="{StaticResource begeClaro}"
                 HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirSegViewCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
        </Border>

        <!-- BOTÃO TERCEIRA VIEW-->
        <Border x:Name="brdBtFundo3" 
              Grid.Column="3" 
              Grid.RowSpan="2"
              TranslationY="5" 
              Margin="5"
              Style="{StaticResource sBrdPrincipalSS}"
              Stroke="{StaticResource palhaMedio}">
            <Label Padding="5"
     />
        </Border>
        <ImageButton x:Name="BtnTercView" 
                   Grid.Column="3" 
                   Grid.RowSpan="2" 
                   Margin="5"
                   Source="{Binding ImgBotao3}"  
                   TranslationY="-10"
                     Command="{Binding AbrirTercViewCommand}"
                   />
        <Border x:Name="brdBtComentarios" 
              Grid.Column="3" 
              Grid.RowSpan="2" 
              Margin="5"
              TranslationY="6" 
              VerticalOptions="Center"
              Padding="0"
              Style="{StaticResource sBrdAzulSS}"
              Stroke="{StaticResource palhaMedio}">
            <Label Text="{Binding LbBotao3}"
                   FontAttributes="Bold"
                 TextColor="{StaticResource begeClaro}" 
                 Padding="0,3"
                   HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirTercViewCommand}"/>
                    </Label.GestureRecognizers>
                <Label.FontSize>
                    <OnIdiom x:TypeArguments="x:Double"
                           Phone ="10"
                           Tablet="12" />
                </Label.FontSize>
            </Label>
        </Border>            
        </Grid>

    <!--view rodapé-->
    <Grid Grid.Row="3"
        BackgroundColor="{StaticResource azulMedio}">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Text="Devma © 2026" 
             TextColor="{StaticResource begeClaro}"
             FontSize="8"
               HorizontalTextAlignment="Center"
               TranslationY="{OnIdiom Phone=0, Desktop=-5}"/>
    </Grid>
        <!-- LOADING -->
        <Grid
    Grid.RowSpan="4"
    Grid.ColumnSpan="2"
    ZIndex="999"
    IsVisible="{Binding Carregando}"
    BackgroundColor="#99f8ca7b"
    InputTransparent="False">

            <Border
        BackgroundColor="Transparent"
        Padding="25"
        StrokeThickness="0"
        HorizontalOptions="Center"
        VerticalOptions="Center">

                <VerticalStackLayout Spacing="10">

                    <ActivityIndicator
                IsRunning="True"
                Color="White"
                WidthRequest="60"
                HeightRequest="60"/>
                    <Label
                FontFamily="FontAwesome"
                        TextColor="{StaticResource marromClaro}"
                        HorizontalOptions="Center"
                Text="&#xf002;"
                FontSize="40" />        

                    <Label
                Text="Consultando Arquivos..."
                TextColor="Black"
                HorizontalOptions="Center"
                        Background="{StaticResource palhaClaro}"/>

                </VerticalStackLayout>

            </Border>

        </Grid>
    </Grid>
    
</ContentPage>