    <!-- imgCabecalho-->
    <Style TargetType="Image" x:Key="sImgCabecalho">
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Shadow">
            <Shadow
                Brush="{StaticResource preto}" Offset="4,4" Opacity="1"/>
        </Setter>
    </Style>

